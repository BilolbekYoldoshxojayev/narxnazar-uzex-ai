# Copy to .env.local (never commit real keys). Comma-separated lists = automatic rotation on rate limits.
GEMINI_API_KEYS=key1,key2,key3
GROQ_API_KEYS=key1,key2
# Optional extra free fallbacks
CEREBRAS_API_KEYS=
OPENROUTER_API_KEYS=
TELEGRAM_BOT_TOKEN=123456:ABC
# Optional overrides
# GEMINI_MODELS=gemini-3.5-flash,gemini-3-flash-preview
# GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile
# PUBLIC_URL=https://your-app.onrender.com   (Render sets RENDER_EXTERNAL_URL automatically)
